{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Founder’s Dilemma",
  "mainBinaryName": "founders-dilemma",
  "version": "2.0.0",
  "identifier": "com.foundersdilemma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Founder's Dilemma",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Startup venturing business simulation",
    "longDescription": "Founder's Dilemma is a business simulation for startup venturing courses: teams found a startup, search for product-market fit, hire, raise money and face the founder's dilemmas, solo or in class.",
    "copyright": "Founder's Dilemma contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
